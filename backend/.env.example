SALGSKORT_DATA_SOURCE=demo
SALGSKORT_GRAPH_TENANT_ID=
SALGSKORT_GRAPH_CLIENT_ID=
SALGSKORT_GRAPH_CLIENT_SECRET=
SALGSKORT_GRAPH_SITE_ID=
SALGSKORT_GRAPH_DRIVE_ITEM_PATH=Delte dokumenter/Salgskort.xlsx
# Optional alternative to SITE_ID + DRIVE_ITEM_PATH for authenticated SharePoint sharing links:
SALGSKORT_GRAPH_SHARE_URL=
SALGSKORT_GRAPH_WORKSHEET_NAME=Salgskort
SALGSKORT_GEOCODE_PROVIDER=dataforsyningen
SALGSKORT_CORS_ALLOW_ORIGINS=http://localhost:5173

# Independent shared manual import. Generate a random team code (at least 24 characters).
# Keep it on the server; never use a VITE_ variable, URL query, or commit a real code.
# Empty/short codes fail closed (503). HTTP Basic username is always nrgi.
SALGSKORT_SHARED_ACCESS_CODE=
# Set to an absolute SQLite file on a persistent volume; parent directory must exist/writable.
# Docker: mount a named persistent volume at /service/data (owned by UID 10001).
SALGSKORT_SHARED_DATABASE_PATH=
# Production: HTTPS only; set CORS_ALLOW_ORIGINS to exact frontend origin(s), never "*".
# Run uvicorn with --no-proxy-headers so client-IP throttling ignores forwarded headers.
# Add a reverse-proxy login rate limiter (the app limiter is bounded and per-process).
# Every authenticated team member may read and replace the one current snapshot.
# No workbook/history is stored; deleting the volume permanently removes the snapshot.
